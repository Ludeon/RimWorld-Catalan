<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: Bioferrite generator -->
  <BioferriteGenerator.stages.Bioferrite_generator.label>generador de bioferrita</BioferriteGenerator.stages.Bioferrite_generator.label>
  <!-- EN: The buzz of that blasted machine will make me mad. It's like nails on a chalkboard. -->
  <BioferriteGenerator.stages.Bioferrite_generator.description>El brunzit de la màquina em fa embogir. És com rascar les ungles en una pissarra.</BioferriteGenerator.stages.Bioferrite_generator.description>
  
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-0.label>ira sanguinària</BloodRage.stages.blood_rage-0.label>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-1.label>ira sanguinària</BloodRage.stages.blood_rage-1.label>
  <!-- EN: I'm really angry. I feel like I could hit someone. -->
  <BloodRage.stages.blood_rage-1.description>Estic molt {PAWN_gender ? enfadat : enfadada}. M’abelleix pegar-li a algu.</BloodRage.stages.blood_rage-1.description>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-2.label>ira sanguinària</BloodRage.stages.blood_rage-2.label>
  <!-- EN: I want to hurt something. I want to hurt something so much. -->
  <BloodRage.stages.blood_rage-2.description>Vull fer mal. Tinc tantes ganes de fer-li mal a algú!</BloodRage.stages.blood_rage-2.description>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-3.label>ira sanguinària</BloodRage.stages.blood_rage-3.label>
  <!-- EN: Smash everything into pieces! You all deserve it! -->
  <BloodRage.stages.blood_rage-3.description>Destrossar-ho tot! Tots us ho mereixeu!</BloodRage.stages.blood_rage-3.description>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-4.label>ira sanguinària</BloodRage.stages.blood_rage-4.label>
  <!-- EN: I'll destroy you! I'll kill you! -->
  <BloodRage.stages.blood_rage-4.description>Us destruiré! Us mataré!</BloodRage.stages.blood_rage-4.description>
  
  <!-- EN: cube sculpture -->
  <CubeSculptures.stages.cube_sculpture.label>escultura cúbica</CubeSculptures.stages.cube_sculpture.label>
  <!-- EN: My sculpture... my beautiful sculpture! -->
  <CubeSculptures.stages.cube_sculpture.description>La meva escultura... La meva preciosa escultura!</CubeSculptures.stages.cube_sculpture.description>
  
  <!-- EN: cube withdrawal -->
  <CubeWithdrawl.stages.cube_withdrawal-0.label>síndrome d’abstinència cúbic</CubeWithdrawl.stages.cube_withdrawal-0.label>
  <!-- EN: I need to see the golden cube. Just once more. Please. -->
  <CubeWithdrawl.stages.cube_withdrawal-0.description>Necessito veure el cub daurat. Una vegada més. Per favor.</CubeWithdrawl.stages.cube_withdrawal-0.description>
  <!-- EN: cube withdrawal -->
  <CubeWithdrawl.stages.cube_withdrawal-1.label>síndrome d’abstinència cúbic</CubeWithdrawl.stages.cube_withdrawal-1.label>
  <!-- EN: Where's that cube? I miss it. I need it! -->
  <CubeWithdrawl.stages.cube_withdrawal-1.description>On està el cub? El trobo a faltar. El necessito!</CubeWithdrawl.stages.cube_withdrawal-1.description>
  <!-- EN: cube withdrawal -->
  <CubeWithdrawl.stages.cube_withdrawal-2.label>síndrome d’abstinència cúbic</CubeWithdrawl.stages.cube_withdrawal-2.label>
  <!-- EN: Where is my cube? Where is it? -->
  <CubeWithdrawl.stages.cube_withdrawal-2.description>On està el meu cub? On està?</CubeWithdrawl.stages.cube_withdrawal-2.description>
  
  <!-- EN: deadlife dust -->
  <DeadlifeDust.stages.deadlife_dust-0.label>pols necrovital</DeadlifeDust.stages.deadlife_dust-0.label>
  <!-- EN: This dust itches bad. -->
  <DeadlifeDust.stages.deadlife_dust-0.description>Aquesta pols pica molt.</DeadlifeDust.stages.deadlife_dust-0.description>
  <!-- EN: deadlife dust -->
  <DeadlifeDust.stages.deadlife_dust-1.label>pols necrovital</DeadlifeDust.stages.deadlife_dust-1.label>
  <!-- EN: I'm breaking out in rashes from this dust. It's burning my skin. -->
  <DeadlifeDust.stages.deadlife_dust-1.description>Em pica tota la pell. Aquesta pols em crema.</DeadlifeDust.stages.deadlife_dust-1.description>
  <!-- EN: deadlife dust -->
  <DeadlifeDust.stages.deadlife_dust-2.label>pols necrovital</DeadlifeDust.stages.deadlife_dust-2.label>
  <!-- EN: This dust stings! I can feel it in my eyes and lungs. -->
  <DeadlifeDust.stages.deadlife_dust-2.description>Aquesta pols pica molt! La noto als ulls i als pulmons.</DeadlifeDust.stages.deadlife_dust-2.description>
  
  <!-- EN: death pall -->
  <DeathPall.stages.death_pall.label>mantell de la mort</DeathPall.stages.death_pall.label>
  <!-- EN: It smells like death. -->
  <DeathPall.stages.death_pall.description>Fa olor a mort.</DeathPall.stages.death_pall.description>
  <!-- EN: death pall exposure -->
  <DeathPall.stages.death_pall_exposure.label>exposició al mantell de la mort</DeathPall.stages.death_pall_exposure.label>
  <!-- EN: It smells like death. My eyes sting and the air grits between my teeth. -->
  <DeathPall.stages.death_pall_exposure.description>Fa olor a mort. Em piquen els ulls i l’aire em crema entre les dents.</DeathPall.stages.death_pall_exposure.description>
  
  <!-- EN: death refusal -->
  <DeathRefusalSickness.stages.death_refusal.label>negamort</DeathRefusalSickness.stages.death_refusal.label>
  <!-- EN: I was dead... I died. It was cold and terrifying. -->
  <DeathRefusalSickness.stages.death_refusal.description>Vaig morir... Feia fred i tenia molta por.</DeathRefusalSickness.stages.death_refusal.description>
  
  <!-- EN: my cube sculpture destroyed -->
  <DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.label>la meva escultura cúbica destruïda</DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.label>
  <!-- EN: My sculpture... my beautiful sculpture... -->
  <DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.description>La meva escultura... La meva bonica escultura...</DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.description>
  
  <!-- EN: monster by my bed -->
  <EntityInRoom.stages.monster_by_my_bed.label>monstre al meu llit</EntityInRoom.stages.monster_by_my_bed.label>
  <!-- EN: I'll never be able to sleep with that twisted thing around! -->
  <EntityInRoom.stages.monster_by_my_bed.description>Mai podré dormir amb aquesta cosa per aquí!</EntityInRoom.stages.monster_by_my_bed.description>
  
  <!-- EN: flesh tentacle -->
  <FleshTentacle.stages.flesh_tentacle.label>tentacle de carn</FleshTentacle.stages.flesh_tentacle.label>
  <!-- EN: Get this thing off of me! -->
  <FleshTentacle.stages.flesh_tentacle.description>Trau-m’ho de sobre!</FleshTentacle.stages.flesh_tentacle.description>
  
  <!-- EN: flesh whip -->
  <FleshWhip.stages.flesh_whip.label>fuet càrnic</FleshWhip.stages.flesh_whip.label>
  <!-- EN: It never stops squirming. I hate it. -->
  <FleshWhip.stages.flesh_whip.description>No para mai de fer-me retòrcer! Ho odio!</FleshWhip.stages.flesh_whip.description>
  
  <!-- EN: gray pall -->
  <GrayPall.stages.gray_pall.label>boira del terror</GrayPall.stages.gray_pall.label>
  <!-- EN: It feels like the world is sick and dying. -->
  <GrayPall.stages.gray_pall.description>Sembla que el món es mor.</GrayPall.stages.gray_pall.description>
  <!-- EN: gray pall exposure -->
  <GrayPall.stages.gray_pall_exposure.label>exposició a la boira del terror</GrayPall.stages.gray_pall_exposure.label>
  <!-- EN: It feels like the world is sick and dying. The putrid air makes me want to vomit. -->
  <GrayPall.stages.gray_pall_exposure.description>Sembla que el món es mor. L’aire pútrid em fa venir ganes de vomitar.</GrayPall.stages.gray_pall_exposure.description>
  
  <!-- EN: harbinger tree scream -->
  <HarbingerScream.stages.harbinger_tree_scream.label>crit de l’arbre dels presagis</HarbingerScream.stages.harbinger_tree_scream.label>
  <!-- EN: I've had a pounding headache ever since that tree died. I can still hear it... -->
  <HarbingerScream.stages.harbinger_tree_scream.description>Tinc maldecap des que va morir l’arbre aquell. Encara el sento...</HarbingerScream.stages.harbinger_tree_scream.description>
  
  <!-- EN: hate chant whispers -->
  <HateChantDrone.stages.hate_chant_whispers.label>càntics d’odi xiuxiuejants</HateChantDrone.stages.hate_chant_whispers.label>
  <!-- EN: I hear their whispers, no matter where I am. Saying wrong things to me over and over. -->
  <HateChantDrone.stages.hate_chant_whispers.description>Sento xiuxiuejos, estigui on estigui. Em diuen coses dolentes una vegada i una altra.</HateChantDrone.stages.hate_chant_whispers.description>
  <!-- EN: quiet hate chanting -->
  <HateChantDrone.stages.quiet_hate_chanting.label>càntics d’odi fluixos</HateChantDrone.stages.quiet_hate_chanting.label>
  <!-- EN: I can hear them muttering, filling my mind with hatred, inside my head. -->
  <HateChantDrone.stages.quiet_hate_chanting.description>Sento com canten a dins del meu cap i omplen la meva ment amb odi.</HateChantDrone.stages.quiet_hate_chanting.description>
  <!-- EN: hate chanting -->
  <HateChantDrone.stages.hate_chanting.label>càntics d’odi</HateChantDrone.stages.hate_chanting.label>
  <!-- EN: Those words being screamed into me, muttered, guttural moans of rage. Inside my head. It's driving me mad! -->
  <HateChantDrone.stages.hate_chanting.description>Aquelles veus que em cridaven, murmuraven... gemecs guturals de ràbia. Dins del meu cap. Em fan embogir!</HateChantDrone.stages.hate_chanting.description>
  <!-- EN: loud hate chanting -->
  <HateChantDrone.stages.loud_hate_chanting.label>càntics d’odi forts</HateChantDrone.stages.loud_hate_chanting.label>
  <!-- EN: The screaming doesn't stop, the chanting, inside me, in my head! -->
  <HateChantDrone.stages.loud_hate_chanting.description>Els crits no paren... Els càntics... A dins del meu cap!</HateChantDrone.stages.loud_hate_chanting.description>
  <!-- EN: extreme hate chanting -->
  <HateChantDrone.stages.extreme_hate_chanting.label>càntics d’odi extremadament forts</HateChantDrone.stages.extreme_hate_chanting.label>
  <!-- EN: Rage in my head murderous rip the skin deserves it the black ocean terror deep... -->
  <HateChantDrone.stages.extreme_hate_chanting.description>La ràbia del meu cap m’esquinça la pell... S’ho mereix... el terror de l’oceà negre de les profunditats...</HateChantDrone.stages.extreme_hate_chanting.description>
  
  <!-- EN: imprisoned with entity -->
  <ImprisonedWithEntity.stages.imprisoned_with_entity.label>empresonat amb una entitat</ImprisonedWithEntity.stages.imprisoned_with_entity.label>
  <!-- EN: I'm trapped in here with that twisted thing! -->
  <ImprisonedWithEntity.stages.imprisoned_with_entity.description>Estic atrapat amb aquesta cosa retorçada!</ImprisonedWithEntity.stages.imprisoned_with_entity.description>
  
  <!-- EN: Joyous presence -->
  <JoyousPresence.stages.Joyous_presence.label>Presència joiosa</JoyousPresence.stages.Joyous_presence.label>
  <!-- EN: Wherever I go, I can feel the joyous one in the back of my mind. It makes me feel good. Very good. -->
  <JoyousPresence.stages.Joyous_presence.description>Vagi on vagi, em sento {PAWN_gender ? joiós : joiosa} i alegre.</JoyousPresence.stages.Joyous_presence.description>
  
  <!-- EN: juggernaut serum -->
  <JuggernautSerum.stages.juggernaut_serum.label>sèrum de la força imparable</JuggernautSerum.stages.juggernaut_serum.label>
  <!-- EN: This stuff messes with my head. I can't stop thinking the worst things. -->
  <JuggernautSerum.stages.juggernaut_serum.description>Aquest líquid juga amb els meus pensaments. No puc parar de pensar coses dolentes.</JuggernautSerum.stages.juggernaut_serum.description>
  
  <!-- EN: neurosis pulse -->
  <NeurosisPulse.stages.neurosis_pulse.label>pols neuròtic</NeurosisPulse.stages.neurosis_pulse.label>
  <!-- EN: Leave me alone! I have work to do! -->
  <NeurosisPulse.stages.neurosis_pulse.description>Deixeu-me tranquil! Tinc millors coses a fer.</NeurosisPulse.stages.neurosis_pulse.description>
  
  <!-- EN: pleasure pulse -->
  <PleasurePulse.stages.pleasure_pulse.label>pols de plaer</PleasurePulse.stages.pleasure_pulse.label>
  <!-- EN: My body ripples with joy. The world is a soft and fuzzy place. -->
  <PleasurePulse.stages.pleasure_pulse.description>El meu cos vibra alegre. El món és bonic i acollidor.</PleasurePulse.stages.pleasure_pulse.description>
  
  <!-- EN: Fascinating tome -->
  <ReadingTome.stages.Fascinating_tome.label>Volum fascinant</ReadingTome.stages.Fascinating_tome.label>
  <!-- EN: Its almost as if it's speaking out to me personally. -->
  <ReadingTome.stages.Fascinating_tome.description>És com si em parlés a mi personalment.</ReadingTome.stages.Fascinating_tome.description>
  
  <!-- EN: Sleep suppressor -->
  <SleepSuppressor.stages.Sleep_suppressor.label>inhibidor del son</SleepSuppressor.stages.Sleep_suppressor.label>
  <!-- EN: The hum of that devilish device grates. I feel it inside my head. What an evil piece of machinery. -->
  <SleepSuppressor.stages.Sleep_suppressor.description>Tinc a dins el brunzit d’aquell aparell diabòlic. El sento dins del meu cap. Quina peça de maquinària més malvada.</SleepSuppressor.stages.Sleep_suppressor.description>
  
  <!-- EN: unsettling conversation -->
  <SpokeToDisturbingMood.stages.unsettling_conversation.label>conversa macabra</SpokeToDisturbingMood.stages.unsettling_conversation.label>
  <!-- EN: An unsettling conversation made me very creeped out. Nobody should think or speak of such things. -->
  <SpokeToDisturbingMood.stages.unsettling_conversation.description>Una conversa inquietant em va fer esgarrifar. Ningú hauria de pensar ni parlar d’aquelles maneres.</SpokeToDisturbingMood.stages.unsettling_conversation.description>
  
  <!-- EN: swallowed by darkness -->
  <SwallowedByDarkness.stages.swallowed_by_darkness.label>foscor engolidora</SwallowedByDarkness.stages.swallowed_by_darkness.label>
  <!-- EN: The darkness is suffocating. I can't see or think! -->
  <SwallowedByDarkness.stages.swallowed_by_darkness.description>La foscor m’ofega. No puc veure ni pensar res!</SwallowedByDarkness.stages.swallowed_by_darkness.description>
  
  <!-- EN: unnatural corpse -->
  <UnnaturalCorpse.stages.unnatural_corpse.label>cadàver antinatural</UnnaturalCorpse.stages.unnatural_corpse.label>
  <!-- EN: Wherever I go, I can feel it watching me. It never stops. -->
  <UnnaturalCorpse.stages.unnatural_corpse.description>On sigui que vagi, sento com em veu. No para mai.</UnnaturalCorpse.stages.unnatural_corpse.description>
  
  <!-- EN: unnatural darkness -->
  <UnnaturalDarkness.stages.unnatural_darkness.label>foscor sobrenatural</UnnaturalDarkness.stages.unnatural_darkness.label>
  <!-- EN: I am suffocated under a blanket of darkness. -->
  <UnnaturalDarkness.stages.unnatural_darkness.description>Em sento ofegat per un mantell de foscor.</UnnaturalDarkness.stages.unnatural_darkness.description>
  <!-- EN: unnatural sky -->
  <UnnaturalDarkness.stages.unnatural_sky.label>cel sobrenatural</UnnaturalDarkness.stages.unnatural_sky.label>
  <!-- EN: The truth finally comes and swallows this false world. -->
  <UnnaturalDarkness.stages.unnatural_sky.description>La veritat sempre arriba i engolirà aquest món fals.</UnnaturalDarkness.stages.unnatural_sky.description>
  
  <!-- EN: captured entity -->
  <VoidFascination.stages.captured_entity.label>entitat capturada</VoidFascination.stages.captured_entity.label>
  <!-- EN: Such a magnificent creature. So much mystery. So much power. -->
  <VoidFascination.stages.captured_entity.description>Quina criatura tan magnífica! Misteriosa i poderosa!</VoidFascination.stages.captured_entity.description>
  
  <!-- EN: void pleasure -->
  <VoidPleasure.stages.void_pleasure.label>el plaer del buit</VoidPleasure.stages.void_pleasure.label>
  <!-- EN: The vibrations of reality pulse into me and soothe everything. -->
  <VoidPleasure.stages.void_pleasure.description>Les vibracions de la realitat ressonen a dins meu i ho calmen tot.</VoidPleasure.stages.void_pleasure.description>
  
  <!-- EN: voidsight -->
  <Voidsight.stages.voidsight.label>vacuvisió</Voidsight.stages.voidsight.label>
  <!-- EN: The serum makes me see so much more. Connections everywhere, emotions flowing. Faces in the shadows. So much... -->
  <Voidsight.stages.voidsight.description>El sèrum em fa veure molt més... Connexions per tot arreu, emocions que flueixen, veig cares a les ombres... Hi ha tantes...</Voidsight.stages.voidsight.description>
  
  <!-- EN: dread leather {0} -->
  <WearingDreadLeather.stages.dread_leather.label>{0} de cuiropor</WearingDreadLeather.stages.dread_leather.label>
  <!-- EN: I hate this stuff. It stinks. -->
  <WearingDreadLeather.stages.dread_leather.description>Aquesta cosa em fa angúnia. I fa molt mala olor.</WearingDreadLeather.stages.dread_leather.description>
  <!-- EN: dread leather {0} (+1) -->
  <WearingDreadLeather.stages.dread_leather_1.label>{0} de cuiropor (+1)</WearingDreadLeather.stages.dread_leather_1.label>
  <!-- EN: Two dread leather items. These make me uncomfortable. -->
  <WearingDreadLeather.stages.dread_leather_1.description>Dos elements fets de cuiropor. Em fan sentir malament.</WearingDreadLeather.stages.dread_leather_1.description>
  <!-- EN: dread leather {0} (+2) -->
  <WearingDreadLeather.stages.dread_leather_2.label>{0} de cuiropor (+2)</WearingDreadLeather.stages.dread_leather_2.label>
  <!-- EN: These three dread leather items make me squirm. They smell awful. -->
  <WearingDreadLeather.stages.dread_leather_2.description>Aquestes tres peces fetes de cuiropor fa que em retorci de fàstic. Fan molt mala olor.</WearingDreadLeather.stages.dread_leather_2.description>
  <!-- EN: dread leather {0} etc -->
  <WearingDreadLeather.stages.dread_leather_etc.label>{0} (i més peces) de cuiropor</WearingDreadLeather.stages.dread_leather_etc.label>
  <!-- EN: I'm covered in this horrible stuff. -->
  <WearingDreadLeather.stages.dread_leather_etc.description>Tinc totes aquestes coses horribles al damunt.</WearingDreadLeather.stages.dread_leather_etc.description>
  
</LanguageData>