  <!-- EN: EMP pulser -->
  <EMPPulser.label>amb pulsor PEM</EMPPulser.label>
  <!-- EN: This weapon can emit a burst of energy centered on the user. The burst will stun nearby electronic targets like mechanoids or turrets. Once used, the pulser takes some time to recharge. -->
