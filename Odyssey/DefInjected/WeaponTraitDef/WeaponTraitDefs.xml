  <!-- EN: flaming -->
  <BioferriteBurner.traitAdjectives.2>flamejant</BioferriteBurner.traitAdjectives.2>
  <!-- EN: burning -->
  <BioferriteBurner.traitAdjectives.3>cremadora</BioferriteBurner.traitAdjectives.3>
  
  <!-- EN: birdshot pellets -->
  <BirdshotPellets.label>amb perdigons fins</BirdshotPellets.label>
  <!-- EN: This weapon fires shells containing smaller pellets than normal. It's much more accurate at close range, but less effective at long range. -->
  <BirdshotPellets.description>Aquesta arma dispara perdigons més petits del normal. És molt més precisa a curta distància, però menys efectiva a llarg abast.</BirdshotPellets.description>
