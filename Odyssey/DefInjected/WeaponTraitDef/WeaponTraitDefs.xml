  <BirdshotPellets.traitAdjectives.1>de curta distància</BirdshotPellets.traitAdjectives.1>
  
  <!-- EN: broadhead arrows -->
  <BroadheadArrows.label>amb fletxes de punta ampla</BroadheadArrows.label>
  <!-- EN: This bow shoots arrows tipped with sharp blades, increasing its damage. -->
  <BroadheadArrows.description>Aquest arc dispara fletxes amb fulles afilades a les puntes que augmenten el dany que provoquen.</BroadheadArrows.description>
