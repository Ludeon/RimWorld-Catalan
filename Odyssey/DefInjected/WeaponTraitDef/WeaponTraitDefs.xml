  <BioferriteBurner.abilityProps.chargeNoun>càrrega del cremador</BioferriteBurner.abilityProps.chargeNoun>
  <!-- EN: on cooldown -->
  <BioferriteBurner.abilityProps.cooldownGerund>en recàrrega</BioferriteBurner.abilityProps.cooldownGerund>
  <!-- EN: fiery -->
  <BioferriteBurner.traitAdjectives.0>ardent</BioferriteBurner.traitAdjectives.0>
  <!-- EN: flame -->
