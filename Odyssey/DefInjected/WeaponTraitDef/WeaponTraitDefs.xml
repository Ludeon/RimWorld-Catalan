  <!-- EN: charge capacitor -->
  <ChargeCapacitor.label>amb condensador de càrregues</ChargeCapacitor.label>
  <!-- EN: This weapon amplifies pulse-charge technology with a massive capacitor, increasing damage and armor penetration. -->
  <ChargeCapacitor.description>Aquesta arma amplifica la tecnologia de càrregues amb un condensador enorme i augmenta el dany i la penetració d'armadures.</ChargeCapacitor.description>
  <!-- EN: overcharged -->
  <ChargeCapacitor.traitAdjectives.0>de supercàrrega</ChargeCapacitor.traitAdjectives.0>
  
  <!-- EN: cumbersome -->
  <Cumbersome.label>poc manejable</Cumbersome.label>
  <!-- EN: This weapon is unwieldy to use, making it slower to aim. -->
  <Cumbersome.description>Aquesta arma és difícil d'utilitzar. El procés d'apuntar és més lent.</Cumbersome.description>
