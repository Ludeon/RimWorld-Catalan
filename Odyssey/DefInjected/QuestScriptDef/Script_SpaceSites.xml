  <OpportunitySite_Asteroid.questNameRules.rulesStrings>
    <li>questName->Asteroide {replace: de [resource]; "de or"-"d’or"; "de obsidiana"-"d’obsidiana"}</li>
  </OpportunitySite_Asteroid.questNameRules.rulesStrings>
